<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>dlg_mdu_rational_method</class>
 <widget class="QDialog" name="dlg_mdu_rational_method">
  <property name="geometry"><rect><x>0</x><y>0</y><width>650</width><height>520</height></rect></property>
  <property name="windowTitle"><string>Metodo Racional / Racional Modificado (MDU)</string></property>
  <layout class="QVBoxLayout" name="main_layout">
   <item>
    <widget class="QTabWidget" name="mainTab">
     <widget class="QWidget" name="tab_input">
      <attribute name="title"><string>Parametros</string></attribute>
      <layout class="QVBoxLayout" name="input_layout">
       <item>
        <widget class="QGroupBox" name="grp_catchment">
         <property name="title"><string>Cuenca</string></property>
         <layout class="QGridLayout" name="grid_catchment">
          <item row="0" column="0"><widget class="QLabel" name="lbl_area"><property name="text"><string>Area [m2]:</string></property></widget></item>
          <item row="0" column="1"><widget class="QLineEdit" name="txt_area"><property name="placeholderText"><string>Area de la cuenca en m2</string></property></widget></item>
          <item row="1" column="0"><widget class="QLabel" name="lbl_intensity"><property name="text"><string>Intensidad i [mm/hr]:</string></property></widget></item>
          <item row="1" column="1"><widget class="QLineEdit" name="txt_intensity"><property name="placeholderText"><string>Intensidad de lluvia</string></property></widget></item>
          <item row="2" column="0"><widget class="QLabel" name="lbl_tc"><property name="text"><string>Tc [min]:</string></property></widget></item>
          <item row="2" column="1"><widget class="QLineEdit" name="txt_tc"><property name="placeholderText"><string>Tiempo de concentracion</string></property></widget></item>
          <item row="3" column="0"><widget class="QLabel" name="lbl_duration"><property name="text"><string>Duracion lluvia D [min]:</string></property></widget></item>
          <item row="3" column="1"><widget class="QLineEdit" name="txt_duration"><property name="placeholderText"><string>Duracion de la tormenta</string></property></widget></item>
         </layout>
        </widget>
       </item>
       <item>
        <widget class="QGroupBox" name="grp_runoff">
         <property name="title"><string>Coeficiente de Escorrentia</string></property>
         <layout class="QGridLayout" name="grid_runoff">
          <item row="0" column="0"><widget class="QLabel" name="lbl_c_method"><property name="text"><string>Metodo:</string></property></widget></item>
          <item row="0" column="1"><widget class="QComboBox" name="cmb_c_method"/></item>
          <item row="1" column="0"><widget class="QLabel" name="lbl_c_value"><property name="text"><string>C ponderado:</string></property></widget></item>
          <item row="1" column="1"><widget class="QLineEdit" name="txt_c_value"><property name="placeholderText"><string>Coeficiente de escorrentia</string></property></widget></item>
         </layout>
        </widget>
       </item>
       <item>
        <widget class="QGroupBox" name="grp_method">
         <property name="title"><string>Metodo de Calculo</string></property>
         <layout class="QVBoxLayout" name="method_layout">
          <item><widget class="QRadioButton" name="rbt_simple"><property name="text"><string>Racional Simple: Q = C*i*A/3.6</string></property><property name="checked"><bool>true</bool></property></widget></item>
          <item><widget class="QRadioButton" name="rbt_modified"><property name="text"><string>Racional Modificado (coef. Temez K)</string></property></widget></item>
         </layout>
        </widget>
       </item>
       <item>
        <widget class="QGroupBox" name="grp_landuse">
         <property name="title"><string>Uso de Suelo (C ponderado)</string></property>
         <layout class="QVBoxLayout" name="landuse_layout">
          <item><widget class="QTableWidget" name="tbl_landuse"/></item>
          <item>
           <layout class="QHBoxLayout" name="landuse_btn_layout">
            <item><widget class="QPushButton" name="btn_add_landuse"><property name="text"><string>Agregar</string></property></widget></item>
            <item><widget class="QPushButton" name="btn_remove_landuse"><property name="text"><string>Eliminar</string></property></widget></item>
            <item><widget class="QPushButton" name="btn_calc_c"><property name="text"><string>Calcular C ponderado</string></property></widget></item>
           </layout>
          </item>
         </layout>
        </widget>
       </item>
      </layout>
     </widget>
     <widget class="QWidget" name="tab_results">
      <attribute name="title"><string>Resultados</string></attribute>
      <layout class="QVBoxLayout" name="results_layout">
       <item><widget class="QTextEdit" name="txt_results"><property name="readOnly"><bool>true</bool></property></widget></item>
       <item><widget class="QTableWidget" name="tbl_hydrograph"/></item>
       <item><layout class="QGridLayout" name="lyt_plot_hydro"/></item>
      </layout>
     </widget>
    </widget>
   </item>
   <item>
    <layout class="QGridLayout" name="lyt_buttons">
     <item><spacer name="spacer"><property name="orientation"><enum>Qt::Horizontal</enum></property></spacer></item>
     <item><widget class="QPushButton" name="btn_calculate"><property name="text"><string>Calcular</string></property></widget></item>
     <item><widget class="QPushButton" name="btn_close"><property name="text"><string>Cerrar</string></property></widget></item>
    </layout>
   </item>
  </layout>
 </widget>
 <resources/>
 <connections/>
</ui>
